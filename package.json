{
  "name": "darse-burhani",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "hikvision:render": "node scripts/configure-render-push.mjs",
    "hikvision:direct-cloud-push": "node scripts/configure-direct-cloud-push.mjs",
    "hikvision:tunnel": "node scripts/configure-tunnel-push.mjs",
    "hikvision:cloud-bridge": "node scripts/hikvision-cloud-bridge.mjs",
    "hikvision:sync": "node scripts/sync-today-scans.mjs",
    "attendance-log:sheet": "npm run attendance-log:sheet -w server",
    "attendence-log:sheet": "npm run attendance-log:sheet -w server",
    "password:reset-faculty": "tsx scripts/reset-faculty-passwords.ts",
    "db:backup": "tsx scripts/backup-supabase-to-local.ts",
    "db:restore": "tsx scripts/restore-local-db.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/exceljs": "^0.5.3",
    "@types/node": "^22.8.0",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
