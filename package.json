{
  "name": "darse-burhani",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "concurrently": "^9.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "xlsx": "^0.18.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/exceljs": "^0.5.3",
    "@types/node": "^22.8.0",
    "concurrently": "^9.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  }
}
