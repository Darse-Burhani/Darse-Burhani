# ── Darse Burhani — Vite + Express stack ────────────────────────────────────
# Copy to `.env` (root) and adjust. Server and client read from this file.

# Database (local PostgreSQL via Docker Compose — see docker-compose.yml)
# Start it with:  docker compose up -d db
DATABASE_URL="postgresql://darseburhani:darseburhani@localhost:5432/darseburhani?schema=public"

# Auth session (JWT) — signs the `sis_session` cookie
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# ── Server (Express) ──
PORT="4000"
# Directory where uploaded files are stored (default: <repo>/public/uploads)
# UPLOAD_DIR="D:/SIS/public/uploads"

# ── Client (Vite SPA) ──
# Where the Vite dev server proxies /api and /uploads to
API_PROXY_TARGET="http://localhost:4000"

# Redis (for leaderboard caching)
REDIS_URL="redis://localhost:6379"

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY="your-firebase-server-key"

# Biometric Gateway
BIOMETRIC_WS_URL="wss://biometric-gateway.school.edu/events"
# Mock device simulator — emits synthetic scans so you can test the system
# without hardware. Toggle at runtime from the Admin → Biometric console.
BIOMETRIC_MOCK="true"
# Optional shared secret guarding the device webhooks
# (POST /api/biometric/events and POST /api/hikvision/events). When set, the
# device push is only accepted with `x-biometric-secret` (or Basic auth whose
# password equals this value). Leave empty in dev.
BIOMETRIC_SECRET=""
# Public URL Hikvision devices push events to (HTTP Event Listening). Defaults
# to NEXT_PUBLIC_APP_URL + /api/hikvision/events. Set this to the external
# IP/domain the device can reach (e.g. https://sis.school.edu/api/hikvision/events).
HIKVISION_PUSH_URL=""
# Terminal (device) the web portal pushes USB-captured fingerprints to.
# Defaults to the first enabled device in Admin → Biometric.
HIKVISION_ENROLL_DEVICE_ID=""

# ── Local USB fingerprint reader bridge (Admin PC) ──────────────────────────
# The bridge runs on the admin machine (see bridge/):
#   cd bridge && npm install && npm start
# It listens on ws://127.0.0.1:8080 and drives the DS-K1F820-F via HCNetSDK.
#   BRIDGE_PORT = "8080"
#   BRIDGE_HOST = "127.0.0.1"
#   HCSDK_DLL_PATH = "C:/Hikvision/HCNetSDK/bin/HCNetSDK.dll"
#   SIMULATE_USB = "1"   # no hardware — synthetic templates
#   CAPTURE_TIMEOUT_MS = "20000"
# The web portal connects to ws://127.0.0.1:8080 to capture a template, then
# POSTs it to /api/members/add-fingerprint which pushes it to the terminal.

# Application
NEXT_PUBLIC_APP_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="Darse Burhani"

# SMTP Email - Primary (Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Darse Burhani <your-email@gmail.com>"

# SMTP Email - Fallback (Outlook, optional)
OUTLOOK_HOST="smtp-mail.outlook.com"
OUTLOOK_PORT="587"
OUTLOOK_SECURE="false"
OUTLOOK_USER="your-email@outlook.com"
OUTLOOK_PASS="your-app-password"
OUTLOOK_FROM="Darse Burhani <your-email@outlook.com>"

# Sentry Error Tracking (Optional — uncomment to enable)
# SENTRY_DSN="https://your-dsn@sentry.io/project-id"
# NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@sentry.io/project-id"
# SENTRY_AUTH_TOKEN="your-auth-token"

# ── Daily Google Sheet attendance log (online) ─────────────────────────────
# 1. Google Cloud → Service Account → JSON key → enable Google Sheets API.
# 2. Create spreadsheet "Darse Burhani — Attendance Log", Share → service-account email as Editor.
# 3. Fill below. Private key: keep the \n escapes on one line.
# GOOGLE_ATTENDANCE_SPREADSHEET_ID="1AbC...xyz"
# GOOGLE_SERVICE_ACCOUNT_EMAIL="svc@project.iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternative: paste the whole JSON key file instead of email+key:
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# GOOGLE_SHEET_DAILY_SYNC="true"
# GOOGLE_SHEET_SYNC_HOUR="15"
